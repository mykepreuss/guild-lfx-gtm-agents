{
  "name": "guild-marketing-os-agents",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:context": "node scripts/check-guild-native.mjs --context",
    "check:guild-native": "node scripts/check-guild-native.mjs",
    "benchmark:context": "node scripts/benchmark-context-variants.mjs",
    "publish:guild-agent": "node scripts/publish-guild-agent.mjs",
    "test:workspace-context-bridge": "node services/workspace-context-publish-bridge/test.mjs",
    "test:contracts": "node scripts/test-suite-contracts.mjs",
    "test:agent-builds": "node scripts/test-agent-builds.mjs",
    "test:launcher-routing": "node scripts/test-launcher-routing.mjs",
    "test:state-adapter": "npm test --prefix services/guild-marketing-os-state",
    "test:state-postgres": "npm run test:postgres:integration --prefix services/guild-marketing-os-state",
    "test:foundation-state": "node scripts/test-foundation-state.mjs",
    "test:guild-adversarial": "node scripts/run-guild-e2e.mjs --adversarial",
    "test:guild-smoke": "node scripts/run-guild-e2e.mjs --smoke",
    "test:guild-smoke:full": "node scripts/run-guild-e2e.mjs --smoke --full",
    "test:guild-smoke:no-cache": "node scripts/run-guild-e2e.mjs --smoke --no-cache",
    "test:guild-smoke:full:no-cache": "node scripts/run-guild-e2e.mjs --smoke --full --no-cache",
    "verify": "npm run test:workspace-context-bridge && npm run test:contracts && npm run test:launcher-routing && npm run test:state-adapter && npm run test:state-postgres && npm run test:foundation-state && npm run test:agent-builds && npm run check:guild-native"
  }
}
