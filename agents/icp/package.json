{
  "name": "@guildai/michaelpreuss~guild-marketing-os-icp",
  "version": "1.0.4",
  "author": "Guild.ai",
  "type": "module",
  "exports": {
    ".": "./dist/agent.js"
  },
  "scripts": {
    "build": "npm run build:compile",
    "build:compile": "tsc --build",
    "bundle": "npm run build && esbuild dist/agent.js --bundle --loader:.md=text --platform=node --format=esm --external:@guildai/agents-sdk | gzip | base64 > agent.js.gz",
    "clean": "tsc --build --clean && rm -rf dist node_modules package-lock.json",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check ."
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.0.4"
  },
  "dependencies": {
    "@guildai/agents-sdk": "0.2.58",
    "@guildai-services/guildai~skills": "1.0.0"
  },
  "files": [
    "./dist/**/*.js",
    "./dist/**/*.d.ts"
  ]
}
