{
  "name": "@guildai/michaelpreuss~guild-marketing-os-launcher",
  "version": "0.3.25",
  "author": "Guild.ai",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/agent.compiled.js"
  },
  "scripts": {
    "build": "npm run build:compile",
    "build:compile": "tsc --build && babel ./dist/agent.js --out-dir ./dist --out-file-extension .compiled.js --plugins @guildai/babel-plugin-agent-compiler",
    "bundle": "npm run build && esbuild dist/agent.compiled.js --bundle --loader:.md=text --platform=node --format=esm --external:@guildai/agents-sdk | gzip | base64 > agent.js.gz",
    "clean": "tsc --build --clean && rm -rf dist node_modules package-lock.json",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check ."
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@guildai/babel-plugin-agent-compiler": "*",
    "esbuild": "0.28.0",
    "typescript": "5.0.4"
  },
  "dependencies": {
    "@guildai/agents-sdk": "0.4.2",
    "zod": "4.4.3"
  },
  "files": [
    "./dist/**/*.js",
    "./dist/**/*.d.ts"
  ]
}
